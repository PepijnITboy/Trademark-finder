# Merkwacht — voorbeeldconfiguratie
# Kopieer dit bestand naar `.env` en vul de echte waarden in.
# Commit nooit een `.env` bestand met echte geheimen.
#
# Dit bestand verzamelt de omgevingsvariabelen voor alle drie de processen
# (apps/api, apps/worker, apps/web). Zie ook de per-app `.env.example`
# bestanden (`apps/api/.env.example`, `apps/worker/.env.example`,
# `apps/web/.env.example`) als je liever losse `.env`-bestanden per app
# gebruikt in plaats van één gedeeld bestand in de root.

# --- Supabase (server: apps/api, apps/worker) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Supabase (client: apps/web) ---
# VITE_-variabelen worden ingebundeld in de browser-bundel: zet hier nooit
# de service-role key of andere server-only geheimen in.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key
VITE_API_BASE_URL=http://localhost:4000

# --- apps/api serverinstellingen ---
NODE_ENV=development
LOG_LEVEL=info
PORT=4000
HOST=0.0.0.0
# Comma-gescheiden lijst van toegestane CORS-origins voor apps/api.
CORS_ORIGIN=http://localhost:5173

# --- apps/worker instellingen ---
# Pollinterval (ms) waarmee de worker naar nieuwe/openstaande taken kijkt.
JOB_POLL_INTERVAL_MS=5000

# --- AI-laag (scoring verrijking) ---
# AI_PROVIDER: "openai" | "none" — met "none" draait de scoring zonder AI-laag.
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key
# Maandelijks uitgavenplafond voor AI-verrijking, in euro's. Bij overschrijding
# schakelt het systeem automatisch terug naar regelgebaseerde scoring.
AI_MONTHLY_BUDGET_EUR=5

# --- Interne authenticatie ---
# Gedeeld geheim waarmee cronjobs/worker-taken zichzelf authenticeren bij de API.
INTERNAL_JOB_SECRET=change-me-to-a-long-random-string

# --- Applicatie-URLs ---
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# --- Ontwikkelmodus ---
# Bij "true" worden externe registerconnectors gemocked en is er geen live
# verkeer naar BOIP of AI-providers nodig om lokaal te ontwikkelen.
DEV_MODE=true

# --- BOIP (Benelux-Bureau voor de Intellectuele Eigendom) ---
# Zonder deze waarden draait de BOIP-connector in "configuration_required" modus
# en worden er GEEN nepgegevens gegenereerd.
BOIP_API_BASE_URL=https://api.boip.int
BOIP_API_KEY=your-boip-api-key
# Bij "true" bedient de BOIP-connector fictieve, LUMARO-achtige fixture-data in
# plaats van live Datolite-verkeer — handig voor lokale ontwikkeling/demo's
# zonder BOIP-inloggegevens. Nooit "true" zetten in productie.
BOIP_USE_FIXTURES=true
