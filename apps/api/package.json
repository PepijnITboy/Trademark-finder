{
  "name": "@merkwacht/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --no-cache --passWithNoTests",
    "build": "echo \"@merkwacht/api: consumed as TypeScript source, no build step\"",
    "test:unit": "vitest run --no-cache --passWithNoTests"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@merkwacht/ai": "workspace:*",
    "@merkwacht/config": "workspace:*",
    "@merkwacht/database": "workspace:*",
    "@merkwacht/domain": "workspace:*",
    "@merkwacht/exports": "workspace:*",
    "@merkwacht/logging": "workspace:*",
    "@merkwacht/normalization": "workspace:*",
    "@merkwacht/opposition-rules": "workspace:*",
    "@merkwacht/phonetics": "workspace:*",
    "@merkwacht/register-connectors": "workspace:*",
    "@merkwacht/scoring": "workspace:*",
    "@merkwacht/shared": "workspace:*",
    "@merkwacht/validation": "workspace:*",
    "fastify": "^5.2.0",
    "stripe": "^22.3.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
